# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GitHub personal access token with repo scope
GITHUB_TOKEN=

# The repo you'll scan and open PRs against, e.g. "yourname/test-repo"
TARGET_REPO=

# Optional. The SDK package you're tracking (default "stripe")
# TARGET_PACKAGE=stripe

# Optional. GitHub repo whose Releases are watched (default "stripe/stripe-node")
# TARGET_PACKAGE_REPO=stripe/stripe-node

# Optional. Port for `npm run dashboard` (default 4200)
# DASHBOARD_PORT=4200

# Optional. Address the dashboard listens on (default 127.0.0.1, this machine only).
# 0.0.0.0 opens it to your network; it has no auth.
# DASHBOARD_HOST=127.0.0.1
